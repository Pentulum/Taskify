<!DOCTYPE html>
<html lang="<%= currentLocale === 'zh' ? 'zh' : 'en' %>">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="../../static/styles/main.css">
    <link rel="stylesheet" href="../../static/styles/partials/feature.css" />
    <title>Document</title>
  </head>
  <body>
    <section class="section feature-section">
      <div class="container feature-container">
          <div class="feature-main-heading">
              <h2 class="feature-secondary-heading"><%= t('feature_title') %></h2>
              <p><%= t('feature_desc') %></p>
          </div>
          <div class="feature-even-column">
              <div class="feature-even-column-left">
                  <div class="feature-features">
                      <img class="feature-img" src="../../static/assets/feature1.webp" alt="feature1">
                      <h3 class="feature-heading"><%= t('feature_1_title') %></h3>
                      <p class="feature-text"><%= t('feature_1_desc') %></p>
                      <a href="#" class="feature-btn feature-btn"><%= t('feature_1_btn') %></a>
                  </div>
                  <div class="feature-features">
                      <img class="feature-img" src="../../static/assets/feature2.webp" alt="feature2">
                      <h3 class="feature-heading"><%= t('feature_2_title') %></h3>
                      <p class="feature-text"><%= t('feature_2_desc') %></p>
                      <a href="#" class="feature-btn feature-btn"><%= t('feature_2_btn') %></a>
                  </div>
                  <div class="feature-features">
                      <img class="feature-img" src="../../static/assets/feature3.webp" alt="feature3">
                      <h3 class="feature-heading"><%= t('feature_3_title') %></h3>
                      <p class="feature-text"><%= t('feature_3_desc') %></p>
                      <a href="#" class="feature-btn feature-btn"><%= t('feature_3_btn') %></a>
                  </div>
              </div>
              <div class="feature-even-column-right">
                  <div class="feature-features">
                      <img class="feature-img" src="../../static/assets/feature4.webp" alt="feature4">
                      <h3 class="feature-heading"><%= t('feature_4_title') %></h3>
                      <p class="feature-text"><%= t('feature_4_desc') %></p>
                      <a href="#" class="feature-btn feature-btn"><%= t('feature_4_btn') %></a>
                  </div>
                  <div class="feature-features">
                      <img class="feature-img" src="../../static/assets/feature5.webp" alt="feature5">
                      <h3 class="feature-heading"><%= t('feature_5_title') %></h3>
                      <p class="feature-text"><%= t('feature_5_desc') %></p>
                      <a href="#" class="feature-btn feature-btn"><%= t('feature_5_btn') %></a>
                  </div>
              </div>
          </div>
      </div>
  </section>
  </body>
</html>
