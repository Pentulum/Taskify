<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="../../static/styles/main.css">
    <link rel="stylesheet" href="../../static/styles/partials/hero.css" />
    <title>Document</title>
  </head>
  <body>
    <section class="section hero-section">
      <div class="container hero-container">
        <div class="hero-col-text">
          <div>
            <h1 class="hero-heading"><%= t('hero_title') %></h1>
          </div>
          <div class="hero-desc">
            <!-- 描述文字也可以在这里添加翻译 -->
          </div>
          <input class="hero-input-email" type="email" name="email" id="hero-email" placeholder="Enter email">
          <a href="#" class="hero-btn"><%= t('hero_btn') %></a>
        </div>
        <div class="hero-col-img">
            <img class="hero-image" src="../../static/assets/laptop.png" alt="laptop">
        </div>
       </div>
      </section>
  </body>
</html>