<!DOCTYPE html>
<html lang="<%= currentLocale === 'zh' ? 'zh' : 'en' %>"></html>
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="../../static/styles/main.css">
    <link rel="stylesheet" href="../../static/styles/partials/nav.css" />
    <title>Document</title>
  </head>
  <body>
    <header>
      <div class="container navbar-container">
        <a href="/" class="logo-wrapper">
          <img src="../../static/assets/logo.png" alt="logo" class="logo" />
          <h1 class="nav-title">Taskify</h1>
        </a>

        <nav>
          <ul class="nav-items">
            <li><a href="/"><%= t('nav_home') %></a></li>
            <li><a href="#"><%= t('nav_features') %></a></li>
            
           <!-- 语言切换：增加 flex 布局确保横向排列 -->
<li style="margin-left: 20px; list-style: none; display: flex; align-items: center; gap: 5px;"> 
  <!-- 英文按钮 -->
  <a href="?lang=en" 
     <% if (currentLocale === 'en') { %> 
        style="font-weight:bold; color:#8000ff; text-decoration:none;" 
     <% } else { %> 
        style="color:#333; text-decoration:none;" 
     <% } %>>EN</a>

  <span style="color:#333;">|</span>

  <!-- 中文按钮 -->
  <a href="?lang=zh" 
     <% if (currentLocale === 'zh') { %> 
        style="font-weight:bold; color:#8000ff; text-decoration:none;" 
     <% } else { %> 
        style="color:#333; text-decoration:none;" 
     <% } %>>中</a>
</li>

          </ul>
        </nav>
        <div class="nav-buttons">
          <a href="/signup" class="btn1 nav-btn"><%= t('nav_signup') %></a>
          <a href="/dashboard" class="btn2 nav-btn"><%= t('nav_login') %></a>
        </div>
      </div>
    </header>
  </body>
</html>