<!DOCTYPE html>
<html lang="<%= currentLocale === 'zh' ? 'zh' : 'en' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= t('privacy_policy') %></title>
    <link rel="stylesheet" href="../static/styles/main.css">
</head>
<body>
   <%- include("partials/nav.ejs") %>

<div class="container" style="padding: 100px 20px; line-height: 1.8; color: #333;">
    <h1><%= t('privacy_policy') %></h1>
    <p style="color: #666; margin-bottom: 30px;"><%= t('privacy_last_updated') %></p>

    <!-- Section 1: Introduction -->
    <section style="margin-bottom: 40px;">
        <h2><%= t('privacy_intro_title') %></h2>
        <p><%= t('privacy_intro_desc') %></p>
    </section>

    <!-- Section 2: Data Collection -->
    <section style="margin-bottom: 40px;">
        <h2><%= t('privacy_collect_title') %></h2>
        <p><%= t('privacy_collect_intro') %></p>
        <ul>
            <li><strong><%= t('privacy_account_label') %>:</strong> <%= t('privacy_account_desc') %></li>
            <li><strong><%= t('privacy_task_label') %>:</strong> <%= t('privacy_task_desc') %></li>
            <li><strong><%= t('privacy_cookie_label') %>:</strong> <%= t('privacy_cookie_desc') %></li>
        </ul>
    </section>

    <!-- Section 3: Use of Data -->
    <section style="margin-bottom: 40px;">
        <h2><%= t('privacy_use_title') %></h2>
        <p><%= t('privacy_use_desc') %></p>
    </section>

    <!-- Section 4: Security -->
    <section style="margin-bottom: 40px;">
        <h2><%= t('privacy_security_title') %></h2>
        <p><%= t('privacy_security_desc') %></p>
    </section>

    <!-- Section 5: Academic Disclaimer (非常重要，对大作业加分) -->
    <section style="margin-bottom: 40px; border: 1px solid #ccc; padding: 20px; background: #f9f9f9;">
        <h2><%= t('privacy_disclaimer_title') %></h2>
        <p><%= t('privacy_disclaimer_desc') %></p>
    </section>

    <a href="/" style="display:inline-block; margin-top:20px; padding:10px 20px; background:#8000ff; color:#fff; text-decoration:none; border-radius:5px;"><%= t('privacy_back_home') %></a>
</div>

<%- include("partials/footer.ejs") %>
</body>
</html>